{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lull",
  "mainBinaryName": "lull",
  "identifier": "io.github.tannhausercommons.lull",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "npm run dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/lull-art/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Music",
    "license": "AGPL-3.0-only",
    "copyright": "Copyright (C) 2026 TannhauserCommons",
    "publisher": "TannhauserCommons",
    "shortDescription": "Self-hosted music player",
    "longDescription": "lull is a music app you host yourself: Soulseek while it downloads, your music folder or Jellyfin, discovery and Last.fm. On Windows and Linux this computer can be your hub; phones and other computers pair with it.",
    "icon": [
      "../web/assets/icons/icon-16.png",
      "../web/assets/icons/icon-24.png",
      "../web/assets/icons/icon-32.png",
      "../web/assets/icons/icon-48.png",
      "../web/assets/icons/icon-64.png",
      "../web/assets/icons/icon-128.png",
      "../web/assets/icons/icon-256.png",
      "../web/assets/icons/icon-512.png",
      "../web/assets/icons/app.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/lull.svg": "../web/assets/app-icon.svg"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/lull.svg": "../web/assets/app-icon.svg"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QTU2NERGRTlCQ0FCNEUKUldST3E3enAzMlNsZENQaVduZno1S2FEbWZ0NVBGWHdnYldNaWZwVm1qSDF1SHRMd1NsSUsvdjcK",
      "endpoints": [
        "https://github.com/TannhauserCommons/lull/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
