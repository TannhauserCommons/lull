{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local",
  "description": "The bundled pages (connect, server unreachable, mini player). The server's web UI gets its own capability at runtime (src/main_window.rs).",
  "windows": ["main", "mini", "strip"],
  "permissions": [
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:event:default",
    "allow-test-server",
    "allow-window-action"
  ]
}
