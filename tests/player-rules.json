  "followEvent": {
    "native": "decides for itself, more loosely: the native player takes every new job of the song it plays (classic_native/engine.rs, adopt), so it follows the job that took over without reading `replaces`",
    "cases": [
      { "job": null, "ev": { "jobId": "j1" }, "expect": "adopt" },
      { "job": "j1", "ev": { "jobId": "j1" }, "expect": "follow" },
      { "job": "j1", "ev": { "jobId": "j2" }, "expect": "drop" },
      { "job": "j1", "ev": { "jobId": "j2", "replaces": "j1" }, "expect": "adopt" },
      { "job": "j1", "ev": { "jobId": "j3", "replaces": "j2" }, "expect": "drop" },
      { "job": "j2", "ev": { "jobId": "j2", "replaces": "j1" }, "expect": "follow" }
    ]
  }
