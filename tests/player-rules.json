{
  "note": "The player's rules as cases, each section one function of web/player-rules.js. The page's player (web/app.js) and the desktop's native Classic player (app/src/desktop/classic_native/rules.rs and the modules that use it) both decide by these rules: tests/web/player-rules.test.mjs runs every case against player-rules.js, and the native engine's tests run every case against its own code, so a rule changed on one side fails CI until the other matches. A section the native player doesn't decide for itself (it takes the page's answer) says so in `native`.",
  "constants": {
    "TICK_MS": 250,
    "SKIP_FAILED_MS": 2500,
    "PREFETCH_MS": 800,
    "LISTEN_GAP_S": 1.5,
    "PREVIOUS_RESTARTS_S": 3,
    "GAPLESS_WITHIN_S": 2,
    "ENDED_EARLY_S": 2,
    "RADIO_AHEAD": 3,
    "RADIO_STEER": 0.4,
    "LOUDNESS_AFTER": 12,
    "LOUDNESS_MIN_DB": -12,
    "LOUDNESS_MAX_DB": 6,
    "SWITCH_LEAD_S": 45,
    "SWITCH_AHEAD_S": 20,
    "SWITCH_TRIES": 3,
    "SWITCH_FADE_S": 0.2,
    "SWITCH_QUIET_S": 3,
    "SWITCH_GLIDE_S": 1.5,
    "SEEK_MARGIN": 0.01
  },
  "nextIndex": [
