  "listening": {
    "note": "One queue entry's time reports [position, playing, waiting], as the output sends them. The play starts at the first report that is playing and not waiting; that report adds nothing, nor does the next; after that each step forward shorter than LISTEN_GAP_S while playing adds itself. `starts`: the report that starts the play (-1: none).",
    "cases": [
      { "reports": [[0, true, true], [0, true, false], [0.25, true, false], [0.5, true, false], [0.75, true, false]], "starts": 1, "heard": 0.5 },
