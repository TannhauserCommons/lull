# Maintainer: TannhauserCommons <350945459+TannhauserCommons@users.noreply.github.com>
#
# Written for each release by lull's release workflow (https://github.com/TannhauserCommons/lull,
# packaging/aur/PKGBUILD.in and scripts/aur-pkgbuild.sh): change it there. The release's .deb, on Arch's own
# WebKitGTK and libraries, checked against the release's checksums and its minisign signature.

pkgname=lull-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Self-hosted music player: Soulseek while it downloads, your music folder or Jellyfin, discovery and Last.fm'
arch=('x86_64' 'aarch64')
url='https://github.com/TannhauserCommons/lull'
license=('AGPL-3.0-only')
depends=(@DEPENDS@)
makedepends=('minisign')
provides=('lull')
conflicts=('lull')
# Already stripped by the release build.
options=('!strip' '!debug')
_release="https://github.com/TannhauserCommons/lull/releases/download/v${pkgver}"
# The key every lull release is signed with (the app's updater key, in tauri.conf.json).
_minisign_key='@MINISIGN_KEY@'
source_x86_64=("lull_${pkgver}_amd64.deb::${_release}/lull_${pkgver}_amd64.deb"
               "lull_${pkgver}_amd64.deb.minisig::${_release}/lull_${pkgver}_amd64.deb.sig")
source_aarch64=("lull_${pkgver}_arm64.deb::${_release}/lull_${pkgver}_arm64.deb"
                "lull_${pkgver}_arm64.deb.minisig::${_release}/lull_${pkgver}_arm64.deb.sig")
sha256sums_x86_64=('@SHA256_AMD64_DEB@'
                   '@SHA256_AMD64_SIG@')
sha256sums_aarch64=('@SHA256_ARM64_DEB@'
                    '@SHA256_ARM64_SIG@')
noextract=("lull_${pkgver}_amd64.deb" "lull_${pkgver}_arm64.deb")

_deb() {
  case "$CARCH" in
    x86_64) echo "lull_${pkgver}_amd64.deb" ;;
    aarch64) echo "lull_${pkgver}_arm64.deb" ;;
  esac
}

prepare() {
  local deb
  deb=$(_deb)
  # The release's .sig is a minisign signature, base64-encoded.
  base64 -d "$deb.minisig" > "$deb.minisign"
  minisign -V -q -m "$deb" -x "$deb.minisign" -P "$_minisign_key"
  mkdir -p deb
  bsdtar -xOf "$deb" 'data.tar.*' | bsdtar -xf - -C deb
}

package() {
  cp -a deb/usr "$pkgdir/"
  cd "$pkgdir/usr"
  # lull runs Arch's own yt-dlp and deno and the AUR's slskd (ADR-0064): the .deb's copies go. lull itself lives in a
  # folder of its own, where it finds what its package says (below).
  rm bin/slskd bin/yt-dlp bin/deno
  install -d lib/lull
  mv bin/lull lib/lull/
  ln -s /usr/lib/lull/lull bin/lull
  # Updates come with pacman: lull's own updater stands down and says so (app/src/desktop/updater.rs).
  printf '%s\n' 'the AUR (lull-bin)' > lib/lull/updates-from
  install -Dm644 lib/lull/licenses/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
