{
  "id": "default",
  "name": "Soft",
  "author": "lull",
  "api": 1,
  "description": "Soft taps and a gentle marimba, for any look.",
  "sounds": {
    "boot": "sounds/boot.ogg",
    "play": "sounds/play.ogg",
    "pause": "sounds/pause.ogg",
    "skip": "sounds/skip.ogg",
    "seek": "sounds/seek.ogg",
    "buffering": {
      "file": "sounds/buffering.ogg",
      "loop": true
    },
    "found": "sounds/found.ogg",
    "stalled": "sounds/stalled.ogg",
    "saved": "sounds/saved.ogg",
    "liked": "sounds/liked.ogg",
    "queued": "sounds/queued.ogg",
    "error": "sounds/error.ogg",
    "design": "sounds/design.ogg",
    "classic": "sounds/classic.ogg"
  },
  "eggs": [
    {
      "name": "night-owl",
      "when": [
        {
          "clock": {
            "from": "03:00",
            "to": "04:00"
          }
        },
        {
          "player": {
            "playing": true
          }
        }
      ],
      "once": "night",
      "sound": "sounds/night-owl.ogg"
    },
    {
      "name": "new-year",
      "when": [
        {
          "clock": {
            "date": "12-31",
            "from": "23:59:50",
            "to": "24:00",
            "countdown": true
          }
        }
      ],
      "line": "{{count}}",
      "once": "year",
      "sound": "sounds/new-year.ogg"
    },
    {
      "name": "new-year-hello",
      "when": [
        {
          "clock": {
            "date": "01-01",
            "from": "00:00",
            "to": "00:00:08"
          }
        }
      ],
      "line": "Happy new year",
      "once": "year"
    },
    {
      "name": "birthday",
      "when": [
        {
          "clock": {
            "date": "10-31"
          }
        }
      ],
      "once": "year",
      "sound": "sounds/birthday.ogg"
    },
    {
      "name": "word",
      "when": [
        {
          "words": {
            "in": [
              "title"
            ],
            "any": [
              "moon",
              "rain",
              "star",
              "sun",
              "snow",
              "night",
              "sea",
              "storm",
              "fire",
              "dream"
            ]
          }
        }
      ],
      "once": "song"
    },
    {
      "name": "still",
      "when": [
        {
          "player": {
            "playing": true,
            "screen": "now",
            "idle": 180
          }
        }
      ],
      "once": "song"
    },
    {
      "name": "on-repeat",
      "when": [
        {
          "repeat": {
            "times": 10
          }
        }
      ],
      "line": "Ten times in a row",
      "once": "song"
    },
    {
      "name": "credits",
      "when": [
        {
          "gesture": {
            "on": "brand",
            "taps": 7,
            "within": 3
          }
        }
      ],
      "go": "#/credits",
      "once": "always"
    },
    {
      "name": "milestone",
      "when": [
        {
          "milestone": {
            "of": "likes",
            "at": [
              100,
              500,
              1000
            ]
          }
        }
      ],
      "line": "{{count}} liked songs",
      "for": 6,
      "once": "always",
      "sound": "sounds/milestone.ogg"
    },
    {
      "name": "long-wait",
      "when": [
        {
          "player": {
            "status": [
              "finding",
              "queued",
              "buffering"
            ],
            "playing": false,
            "held": 20
          }
        }
      ],
      "instead": true,
      "once": "song",
      "sound": {
        "file": "sounds/long-wait.ogg",
        "loop": true
      }
    },
    {
      "name": "rare-boot",
      "when": [
        {
          "event": {
            "on": "boot"
          }
        },
        {
          "chance": {
            "one_in": 40
          }
        }
      ],
      "instead": true,
      "once": "always",
      "sound": "sounds/rare-boot.ogg"
    }
  ]
}
