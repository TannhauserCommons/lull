{
  "id": "petal",
  "name": "Pixel zine",
  "author": "lull",
  "api": 1,
  "description": "8-bit blips, a tape deck clunk, and a VHS tape finding its tracking.",
  "sounds": {
    "boot": "sounds/boot.ogg",
    "play": "sounds/play.ogg",
    "pause": "sounds/pause.ogg",
    "skip": "sounds/skip.ogg",
    "seek": "sounds/seek.ogg",
    "buffering": {
      "file": "sounds/buffering.ogg",
      "loop": true
    },
    "found": "sounds/found.ogg",
    "stalled": "sounds/stalled.ogg",
    "saved": "sounds/saved.ogg",
    "liked": "sounds/liked.ogg",
    "queued": "sounds/queued.ogg",
    "error": "sounds/error.ogg",
    "design": "sounds/design.ogg",
    "classic": "sounds/classic.ogg"
  },
  "eggs": [
    {
      "name": "night-owl",
      "when": [
        {
          "clock": {
            "from": "03:00",
            "to": "04:00"
          }
        },
        {
          "player": {
            "playing": true
          }
        }
      ],
      "once": "night",
      "sound": "sounds/night-owl.ogg"
    },
    {
      "name": "new-year",
      "when": [
        {
          "clock": {
            "date": "12-31",
            "from": "23:59:50",
            "to": "24:00",
            "countdown": true
          }
        }
      ],
      "line": "{{count}}",
      "once": "year",
      "sound": "sounds/new-year.ogg"
    },
    {
      "name": "birthday",
      "when": [
        {
          "clock": {
            "date": "10-31"
          }
        }
      ],
      "once": "year",
      "sound": "sounds/birthday.ogg"
    },
    {
      "name": "on-repeat",
      "when": [
        {
          "repeat": {
            "times": 10
          }
        }
      ],
      "line": "Ten times in a row",
      "once": "song",
      "sound": "sounds/on-repeat.ogg"
    },
    {
      "name": "milestone",
      "when": [
        {
          "milestone": {
            "of": "likes",
            "at": [
              100,
              500,
              1000
            ]
          }
        }
      ],
      "line": "{{count}} liked songs",
      "for": 6,
      "once": "always",
      "sound": "sounds/milestone.ogg"
    },
    {
      "name": "long-wait",
      "when": [
        {
          "player": {
            "status": [
              "finding",
              "queued",
              "buffering"
            ],
            "playing": false,
            "held": 20
          }
        }
      ],
      "instead": true,
      "once": "song",
      "sound": {
        "file": "sounds/long-wait.ogg",
        "loop": true
      }
    },
    {
      "name": "rare-boot",
      "when": [
        {
          "event": {
            "on": "boot"
          }
        },
        {
          "chance": {
            "one_in": 40
          }
        }
      ],
      "instead": true,
      "once": "always",
      "sound": "sounds/rare-boot.ogg"
    },
    {
      "name": "bunny-hop",
      "when": [
        {
          "gesture": {
            "on": "title",
            "taps": 3,
            "within": 2
          }
        }
      ],
      "line": "hop hop hop",
      "for": 6,
      "once": "always",
      "sound": "sounds/bunny-hop.ogg"
    },
    {
      "name": "sticker-rain",
      "when": [
        {
          "event": {
            "on": "liked"
          }
        },
        {
          "chance": {
            "one_in": 8
          }
        }
      ],
      "line": "Sticker sheet, just for you",
      "for": 6,
      "once": "session",
      "sound": "sounds/sticker-rain.ogg"
    },
    {
      "name": "side-b",
      "when": [
        {
          "player": {
            "status": "ended"
          }
        }
      ],
      "line": "Flip to side B",
      "once": "song",
      "sound": "sounds/side-b.ogg"
    },
    {
      "name": "margin-doodle",
      "when": [
        {
          "player": {
            "playing": true,
            "idle": 90,
            "screen": [
              "home",
              "search",
              "library",
              "liked",
              "history",
              "following",
              "album",
              "artist",
              "tag",
              "playlists",
              "playlist",
              "stats"
            ]
          }
        }
      ],
      "once": "song",
      "sound": "sounds/margin-doodle.ogg"
    }
  ]
}
