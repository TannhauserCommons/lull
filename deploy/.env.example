# lull settings. Copy to .env next to compose.yaml and fill in. Every key lull reads is here;
# an unknown LULL_* key stops lull at start-up, so typos never pass silently.
# The same keys can live in a file named by LULL_CONFIG instead (the environment wins).
# Keys without the LULL_ prefix are for compose and slskd; lull ignores them.

# ---------- deploy kit (docs/context/deploy.md) ----------
# The shape: plain (lull + slskd), vpn (lull + slskd behind gluetun), or empty (lull alone, with
# an slskd you already run; then set LULL_SLSKD_URL, LULL_SLSKD_API_KEY and TRANSFERS to yours).
COMPOSE_PROFILES=plain
# lull's image tag: main (the latest green build) or sha-<commit> to pin one.
IMAGE_TAG=main
# User:group both containers run as: the owner of MUSIC_DIR (run `id -u` and `id -g`).
RUN_AS=1000:1000
# Host port for the lull web UI.
PORT=8080
# Jellyfin's music folder on the host. lull writes saved songs here; slskd shares it read-only.
MUSIC_DIR=/srv/music
# slskd's files: a docker volume by default. With your own slskd, the host folder holding its
# incomplete and downloads folders (lull streams from the first and saves from the second).
TRANSFERS=transfers
# Optional: a folder of Winamp skins (.wsz) you already keep on the host, for Classic mode; lull
# only reads it (set LULL_SKINS_DIR=/skins below too). Not needed: skins added in the app are kept
# in lull's own data. Empty = none (an empty docker volume).
SKINS_DIR=

# ---------- slskd (plain and vpn shapes) ----------
# The Soulseek account slskd logs in with. Soulseek allows one login per account at a time.
SLSK_USERNAME=
SLSK_PASSWORD=
# The port peers connect to. Plain shape: forward it on your router for more peers (optional).
# VPN shape: ignored, slskd listens on the VPN's forwarded port.
SLSK_LISTEN_PORT=50300

# ---------- VPN (vpn shape; gluetun) ----------
# A provider whose servers forward a port: private internet access, protonvpn, perfect privacy
# or privatevpn. Settings per provider: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
OPENVPN_USER=
OPENVPN_PASSWORD=
VPN_SERVER_COUNTRIES=
# Any random string (openssl rand -hex 24): slskd uses it to ask gluetun for the forwarded port.
GLUETUN_API_KEY=

# ---------- server ----------
# Address lull listens on inside the container.
LULL_LISTEN=0.0.0.0:8080
# The URL you open lull at. Needed for the Last.fm sign-in callback.
LULL_PUBLIC_URL=https://lull.example.com
# The code that pairs the first device. Empty: lull prints a fresh one in its log while no
# device is paired.
LULL_SETUP_CODE=
# Where lull keeps its database (likes, playlists, history, taste). Back this up.
LULL_DATA_DIR=/data
# Log filter: error, warn, info, debug, or per module (info,lull_soulseek=debug).
LULL_LOG=info

# ---------- Soulseek (through slskd) ----------
# slskd's address as lull reaches it, and an API key slskd accepts. In the plain and vpn shapes
# slskd takes this key as its administrator key: pick 16 to 255 random characters
# (openssl rand -hex 24). With your own slskd, add it to slskd's web.authentication.api_keys
# with role administrator (a readwrite key works, but lull then assumes the kit's folder names).
LULL_SLSKD_URL=http://slskd:5030
LULL_SLSKD_API_KEY=
# slskd's own web login. slskd lets only a web session (not an API key) restart it, so lull uses
# this to restart an slskd that is stuck mid-connection after fresh logins didn't help. In the
# plain and vpn shapes slskd takes these as its login; set both (any user name, a long random
# password). With your own slskd, its web.authentication username and password. Empty: lull
# never restarts slskd, and /health says when it should be.
LULL_SLSKD_WEB_USERNAME=
LULL_SLSKD_WEB_PASSWORD=
# The folder holding slskd's incomplete and downloads folders, as mounted into lull: lull streams
# files while slskd writes them, and evicts the ones it fetched when the cache is full.
LULL_TRANSFERS_DIR=/transfers
# For the desktop app only, which runs its own slskd: it points LULL_SLSKD_CONFIG_FILE at that
# slskd's config file, lull writes the Soulseek account into it, and the account is set in lull
# (Settings or first-run setup). Leave all three empty here: in this kit the account is
# SLSK_USERNAME and SLSK_PASSWORD above.
LULL_SLSKD_CONFIG_FILE=
LULL_SOULSEEK_USERNAME=
LULL_SOULSEEK_PASSWORD=
# Formats you prefer, best first (file extensions).
LULL_PREFERRED_FORMATS=flac,mp3,opus,ogg,m4a
# What you share on Soulseek: "library" (your saved music, read-only) or "none". Soulseek
# etiquette expects sharing; many peers refuse users who share nothing.
LULL_SHARE=library
# Space for streamed songs you haven't saved. The oldest unused ones are removed first.
LULL_CACHE_MAX_GB=10

# ---------- Library ----------
# Where your saved music comes from: folder (lull indexes LULL_MUSIC_DIR itself) or jellyfin.
# Empty = jellyfin when LULL_JELLYFIN_URL is set, else folder. The app can switch it too.
LULL_LIBRARY=
# Your music folder as mounted into lull; saved songs are written here in both modes.
# In Jellyfin mode, it is Jellyfin's music library folder.
LULL_MUSIC_DIR=/music
# Path of a saved file inside LULL_MUSIC_DIR.
LULL_NAMING={albumartist}/{album} ({year})/{disc}{track:02} - {title}

# ---------- Jellyfin (optional) ----------
# Leave both empty to use the music folder alone. The app can also connect Jellyfin for you
# (Quick Connect, or a one-time sign-in) and store these.
# Example: http://jellyfin:8096
LULL_JELLYFIN_URL=
# Jellyfin > Dashboard > API Keys.
LULL_JELLYFIN_API_KEY=
# Jellyfin user whose library lull uses. Empty = the first administrator.
LULL_JELLYFIN_USER=

# ---------- Last.fm (optional) ----------
# Release builds of lull carry the project's own Last.fm API account: just press Connect in Settings.
# Set these only to use your own (create one at https://www.last.fm/api/account/create), which
# overrides it. A build without the project's account (your own `cargo build`) and no key here
# has scrobbling off.
LULL_LASTFM_API_KEY=
LULL_LASTFM_API_SECRET=

# ---------- discovery (optional) ----------
# Your ListenBrainz user name (and token) for personal recommendations.
LULL_LISTENBRAINZ_USER=
LULL_LISTENBRAINZ_TOKEN=
# Search reads Deezer's catalog where Deezer is open. Where it isn't (in some countries), tracks and
# albums come from Apple's iTunes Search in this country's store (two letters; default US).
LULL_CATALOG_COUNTRY=

# ---------- Classic mode (optional) ----------
# Skins you add in Settings › Appearance › Classic (from any device) are kept in lull's data
# (/data/skins/mine), so every device has them and they are backed up with the rest; nothing to set.
# Optional: a folder of .wsz files lull reads as well, never changing it. With the deploy kit, set
# SKINS_DIR above and this to /skins. Empty = none.
LULL_SKINS_DIR=

# ---------- unfinished features (for whoever builds them) ----------
# Turns on work that has landed switched off (lull_core::flags, ADR-0096): names separated by
# commas. A name lull doesn't know stops it starting. Empty = everything off, as released.
LULL_FLAGS=

# ---------- YouTube (off until you turn it on in Settings › Sources) ----------
# yt-dlp and the JavaScript runtime it needs for YouTube. The image ships both, pinned; leave these
# empty to use them (or the ones on PATH when you run lull yourself).
LULL_YTDLP=
LULL_DENO=
