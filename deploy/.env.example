# lull settings. Copy to .env next to compose.yaml and fill in. Every key lull reads is here;
# an unknown LULL_* key stops lull at start-up, so typos never pass silently.
# The same keys can live in a file named by LULL_CONFIG instead (the environment wins).

# ---------- server ----------
# Address lull listens on inside the container.
LULL_LISTEN=0.0.0.0:8080
# The URL you open lull at. Needed for the Last.fm sign-in callback.
LULL_PUBLIC_URL=https://lull.example.com
# Optional shared token. When set, the UI asks for it once per device. Leave empty on a private network.
LULL_ACCESS_TOKEN=
# Where lull keeps its database (likes, playlists, history, taste). Back this up.
LULL_DATA_DIR=/data
# Log filter: error, warn, info, debug, or per module (info,lull_soulseek=debug).
LULL_LOG=info

# ---------- Soulseek (through slskd) ----------
# slskd's address as lull reaches it, and an API key slskd accepts.
LULL_SLSKD_URL=http://slskd:5030
LULL_SLSKD_API_KEY=
# slskd's download folder, mounted into lull too: lull streams files while slskd writes them.
LULL_TRANSFERS_DIR=/transfers
# Formats you prefer, best first (file extensions).
LULL_PREFERRED_FORMATS=flac,mp3,opus,ogg,m4a
# What you share on Soulseek: "library" (your saved music, read-only) or "none".
LULL_SHARE=library
# Space for streamed songs you haven't saved. The oldest unused ones are removed first.
LULL_CACHE_MAX_GB=10

# ---------- Jellyfin ----------
# Leave both empty to run without Jellyfin (streaming only, nothing can be saved).
LULL_JELLYFIN_URL=http://jellyfin:8096
# Jellyfin > Dashboard > API Keys.
LULL_JELLYFIN_API_KEY=
# Jellyfin user whose library lull uses. Empty = the first administrator.
LULL_JELLYFIN_USER=
# Jellyfin's music library folder as mounted into lull; saved songs are written here.
LULL_MUSIC_DIR=/music
# Path of a saved file inside LULL_MUSIC_DIR.
LULL_NAMING={albumartist}/{album} ({year})/{disc}{track:02} - {title}

# ---------- Last.fm (optional) ----------
# Create an API account at https://www.last.fm/api/account/create. Leave empty to turn scrobbling off.
LULL_LASTFM_API_KEY=
LULL_LASTFM_API_SECRET=

# ---------- discovery (optional) ----------
# Your ListenBrainz user name (and token) for personal recommendations.
LULL_LISTENBRAINZ_USER=
LULL_LISTENBRAINZ_TOKEN=
